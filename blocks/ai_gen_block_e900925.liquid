{% doc %}
  @prompt
    a row with two columns, where one column has a countdown timer and the other column has a coming soon image along with get notified button, notify me should be in the same row, overall one row with two columns, one having countdown timer and other with notify me containing a background
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign timer_parts = 'days,hours,minutes,seconds' | split: ',' %}{% style %}.ai-coming-soon-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.text_color }}}.ai-coming-soon-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:{{ block.settings.column_gap }}px}.ai-coming-soon-{{ ai_gen_id }}__panel{display:flex;flex-direction:column;justify-content:center;padding:{{ block.settings.panel_padding }}px;background:{{ block.settings.background_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px}.ai-coming-soon-{{ ai_gen_id }}__heading{margin:0 0 12px;font-size:{{ block.settings.heading_size }}px}.ai-coming-soon-{{ ai_gen_id }}__eyebrow{margin:0 0 12px;color:{{ block.settings.accent_color }};font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ai-coming-soon-{{ ai_gen_id }}__description{line-height:1.5}.ai-coming-soon-{{ ai_gen_id }}__timer{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:24px 0}.ai-coming-soon-{{ ai_gen_id }}__unit{padding:12px 4px;text-align:center;background:{{ block.settings.timer_background }};border-radius:{{ block.settings.border_radius }}px}.ai-coming-soon-{{ ai_gen_id }}__number,.ai-coming-soon-{{ ai_gen_id }}__label{display:block;color:{{ block.settings.timer_text_color }}}.ai-coming-soon-{{ ai_gen_id }}__number{font-size:25px;font-weight:700}.ai-coming-soon-{{ ai_gen_id }}__label{font-size:11px;text-transform:uppercase}.ai-coming-soon-{{ ai_gen_id }}__media{min-height:260px;margin-bottom:22px;background:{{ block.settings.image_placeholder_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden}.ai-coming-soon-{{ ai_gen_id }}__media img,.ai-coming-soon-{{ ai_gen_id }}__media-placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-coming-soon-{{ ai_gen_id }}__media-placeholder{display:flex;align-items:center;justify-content:center;min-height:260px}.ai-coming-soon-{{ ai_gen_id }}__form{display:flex;gap:10px;margin-top:12px}.ai-coming-soon-{{ ai_gen_id }}__input{flex:1;min-width:0;padding:13px;border:1px solid {{ block.settings.border_color }};background:{{ block.settings.input_background }};border-radius:{{ block.settings.border_radius }}px;font:inherit}.ai-coming-soon-{{ ai_gen_id }}__button{padding:13px 18px;color:{{ block.settings.button_text_color }};background:{{ block.settings.button_color }};border:0;border-radius:{{ block.settings.border_radius }}px;font:inherit;font-weight:700}.ai-coming-soon-{{ ai_gen_id }}__button:focus-visible,.ai-coming-soon-{{ ai_gen_id }}__input:focus-visible{outline:3px solid {{ block.settings.accent_color }};outline-offset:2px}@media(max-width:749px){.ai-coming-soon-{{ ai_gen_id }}__grid{grid-template-columns:1fr}.ai-coming-soon-{{ ai_gen_id }}__form{flex-direction:column}}{% endstyle %}<coming-soon-{{ ai_gen_id }} class="ai-coming-soon-{{ ai_gen_id }}" data-end-date="{{ block.settings.end_date | escape }}" {{ block.shopify_attributes }}><div class="ai-coming-soon-{{ ai_gen_id }}__grid"><div class="ai-coming-soon-{{ ai_gen_id }}__panel"><p class="ai-coming-soon-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-coming-soon-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2><p class="ai-coming-soon-{{ ai_gen_id }}__description">{{ block.settings.description }}</p><div class="ai-coming-soon-{{ ai_gen_id }}__timer" role="timer" aria-live="polite">{% for part in timer_parts %}<div class="ai-coming-soon-{{ ai_gen_id }}__unit"><span class="ai-coming-soon-{{ ai_gen_id }}__number" data-part="{{ part }}">00</span><span class="ai-coming-soon-{{ ai_gen_id }}__label">{{ part }}</span></div>{% endfor %}</div><p data-status></p></div><div class="ai-coming-soon-{{ ai_gen_id }}__panel"><div class="ai-coming-soon-{{ ai_gen_id }}__media">{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy">{% else %}<div class="ai-coming-soon-{{ ai_gen_id }}__media-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><h2 class="ai-coming-soon-{{ ai_gen_id }}__heading" style="font-size:22px">{{ block.settings.notify_heading }}</h2>{% form 'contact' %}<div class="ai-coming-soon-{{ ai_gen_id }}__form"><input class="ai-coming-soon-{{ ai_gen_id }}__input" type="email" name="contact[email]" placeholder="{{ block.settings.email_placeholder | escape }}" autocomplete="email" required><button class="ai-coming-soon-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label }}</button></div>{% endform %}{% if form.posted_successfully? %}<p>{{ block.settings.success_message }}</p>{% endif %}</div></div></coming-soon-{{ ai_gen_id }}><script>(function(){class C extends HTMLElement{connectedCallback(){this.e=new Date(this.dataset.endDate).getTime();this.u();this.i=setInterval(()=>this.u(),1000)}disconnectedCallback(){clearInterval(this.i)}u(){let r=this.e-Date.now(),v={days:Math.floor(r/864e5),hours:Math.floor(r/36e5)%24,minutes:Math.floor(r/6e4)%60,seconds:Math.floor(r/1e3)%60};Object.keys(v).forEach(k=>{let x=this.querySelector('[data-part="'+k+'"]');if(x)x.textContent=r>0?String(v[k]).padStart(2,'0'):'00'});if(r<=0)this.querySelector('[data-status]').textContent='Coming soon'}}customElements.define('coming-soon-{{ ai_gen_id }}',C)})();</script>{% schema %}{"name":"Coming soon row","tag":null,"class":"coming-soon-row-block","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Launching soon"},{"type":"text","id":"heading","label":"Heading","default":"Something special is on the way"},{"type":"textarea","id":"description","label":"Description","default":"Be the first to know when our next release arrives."},{"type":"text","id":"end_date","label":"Launch date and time","default":"2026-12-31T23:59:59-04:00"},{"type":"image_picker","id":"image","label":"Coming soon image"},{"type":"text","id":"notify_heading","label":"Notify heading","default":"Get notified"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"button_label","label":"Button label","default":"Notify me"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks! We will let you know when it launches."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"column_gap","label":"Column gap","min":8,"max":48,"step":4,"unit":"px","default":20},{"type":"range","id":"panel_padding","label":"Panel padding","min":16,"max":64,"step":4,"unit":"px","default":32},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":56,"step":4,"unit":"px","default":36},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":40,"step":4,"unit":"px","default":0},{"type":"color","id":"background_color","label":"Background","default":"#F3F3F3"},{"type":"color","id":"text_color","label":"Text","default":"#121212"},{"type":"color","id":"accent_color","label":"Accent","default":"#334FB4"},{"type":"color","id":"border_color","label":"Border","default":"#D9D9D9"},{"type":"color","id":"timer_background","label":"Timer background","default":"#121212"},{"type":"color","id":"timer_text_color","label":"Timer text","default":"#FFFFFF"},{"type":"color","id":"image_placeholder_color","label":"Image placeholder","default":"#E5E5E5"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"button_color","label":"Button","default":"#121212"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"}],"presets":[{"name":"Coming soon row"}]}{% endschema %}